library(httr)
url <- parse_url("https://maps2.dcgis.dc.gov/dcgis/rest/services/DCGIS_DATA/Planning_WebMercator/MapServer/7/query")
url$query <- list(
where       = "1=1",       # return all records
outFields   = "*",         # return all fields
f           = "geojson"    # return as GeoJSON
)
response <- build_url(url)
historic_districts <- st_read(response)
hd_shp <- st_read("https://maps2.dcgis.dc.gov/dcgis/rest/services/DCGIS_DATA/Historic_WebMercator/MapServer/6/query?outFields=*&where=1%3D1&f=geojson")
hd_shp <- st_read("https://maps2.dcgis.dc.gov/dcgis/rest/services/DCGIS_DATA/Historic_WebMercator/MapServer/6/query?outFields=*&where=1%3D1&f=geojson", quietly=T)
hd_shp <- st_read("https://maps2.dcgis.dc.gov/dcgis/rest/services/DCGIS_DATA/Historic_WebMercator/MapServer/6/query?outFields=*&where=1%3D1&f=geojson", quietly=T)
hd_shp <- st_read("https://maps2.dcgis.dc.gov/dcgis/rest/services/DCGIS_DATA/Historic_WebMercator/MapServer/6/query?outFields=*&where=1%3D1&f=geojson")
View(hd_shp)
# Merge historic district (HD) data onto HD shapefile, subset to only look at neighborhood HDs:
hd_shp <- dplyr::left_join(x = hd_shp, y = hd_data, by = "UNIQUEID")
hd_shp <- hd_shp %>% filter(Neighborhood_HD==1)
buildings <- st_read("data/DC_buildings_height_2024_MEAN.geojson")
setwd("~/GitHub/blg-heights-analysis")
buildings <- st_read("data/DC_buildings_height_2024_MEAN.geojson")
buildings <- st_read("data/DC_buildings_height_2024_MEAN.json")
# Project to UTM Zone 18N (meters) so distances are meaningful
crs_m <- 32618
buildings          <- st_transform(buildings, crs_m)
# Merge historic district (HD) data onto HD shapefile, subset to only look at neighborhood HDs:
historic_districts <- dplyr::left_join(x = hd_shp, y = hd_data, by = "UNIQUEID")
historic_districts <- hd_shp %>% filter(Neighborhood_HD==1)
buildings          <- st_transform(buildings, crs_m)
historic_districts <- st_transform(historic_districts, crs_m)
# Add a unique building ID for tracking
buildings <- buildings %>% mutate(bldg_id = row_number())
# ── 2. Check column names before proceeding ───────────────────────────────────
# Run these to confirm the right column names on your data:
names(buildings)          # look for the height column
names(historic_districts) # look for the district name column
View(buildings)
View(historic_districts)
plot(buildings[1:5])
plot(buildings[1:5, "bldg_ht_m"])
